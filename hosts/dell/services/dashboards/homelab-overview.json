  "panels": [
    {
      "id": 20,
      "type": "table",
      "title": "Hosts — current status and capacity",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "description": "One row per configured node target, including down hosts. RAM used = total − available. CPU temperature = hottest identified CPU sensor (package/core), never arbitrary firmware sensors; unavailable on many VMs. Storage is the root filesystem only, not LVM-thin/VM pool capacity. Missing metrics remain N/A.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (up{job=\"node\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (instance) (node_memory_MemTotal_bytes{job=\"node\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(max by (instance) (node_memory_MemTotal_bytes{job=\"node\"})) - (max by (instance) (node_memory_MemAvailable_bytes{job=\"node\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "100 * (1 - (max by (instance) (node_memory_MemAvailable_bytes{job=\"node\"}) / max by (instance) (node_memory_MemTotal_bytes{job=\"node\"})))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "count by (instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node\"} * on (instance, job, chip) group_left(chip_name) node_hwmon_chip_names{job=\"node\",chip_name=~\"coretemp|k10temp|cpu_thermal\"}) or max by (instance) (node_thermal_zone_temp{job=\"node\",type=~\"cpu-thermal|cpu_thermal|x86_pkg_temp\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "expr": "max by (instance) (node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "expr": "100 * (1 - (max by (instance) (node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"}) / max by (instance) (node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"})))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "instance",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G",
                "Value #H",
                "Value #I"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "RAM total",
              "Value #C": "RAM used",
              "Value #D": "RAM used %",
              "Value #E": "Logical CPUs",
              "Value #F": "CPU used %",
              "Value #G": "CPU °C",
              "Value #H": "Root capacity",
              "Value #I": "Root used %",
              "instance": "Host"
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Host"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
